# Placeholders only. Copy to .env and fill in real values. Never commit .env.

# Public (reaches the browser). Anon key ONLY, never service_role.
# Either pair works; the VITE_ pair takes precedence.
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-anon-key
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Public Stripe publishable key (used in the browser)
VITE_PUBLIC_STRIPE_KEY_LIVE=pk_live_xxx

# Server-only secrets (read via process.env / import.meta.env in +server.js files only).
# NOTE: VITE_-prefixed vars are statically inlined by Vite wherever they are referenced,
# so only reference them from server-only files.
VITE_SECRET_STRIPE_KEY_LIVE=sk_live_xxx
VITE_STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_RESEND_KEY=re_xxx
SUPABASE_PASSWORD=xxx
GMAIL_ADDRESS=xxx
GMAIL_APP_PASSWORD=xxx
